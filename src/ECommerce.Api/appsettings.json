{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ECommerceDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "JwtSettings": {
    "Key": "THIS_IS_A_DEMO_SECRET_KEY_CHANGE_IT_LATER_12345",
    "Issuer": "ECommerceApi",
    "Audience": "ECommerceApiUsers",
    "ExpiresInMinutes": 60
  }
}
